{
  "name": "tracewell",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --workspace=client\" \"node server/index.js\"",
    "build": "npm run build --workspace=client",
    "start": "npm run build --workspace=client && node server/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
